tion":[],"name":"Center For Open Science","nameIdentifiers":[{"nameIdentifierScheme":"URL","nameIdentifier":"https://cos.io/"},{"nameIdentifierScheme":"ROR","schemeUri":"https://ror.org","nameIdentifier":"https://ror.org/05d5mza29"}],"contributorType":"HostingInstitution"}],"dates":[{"date":"2023-12-22","dateType":"Created"},{"date":"2025-03-28","dateType":"Updated"},{"date":"2024-12-21","dateType":"Available"},{"date":"2023","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"StudyRegistration","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Pre-registration"},"relatedIdentifiers":[{"relationType":"IsIdenticalTo","relatedIdentifier":"https://archive.org/details/osf-registrations-8gnar-v1","relatedIdentifierType":"URL"},{"relationType":"IsVersionOf","relatedIdentifier":"https://osf.io/sq4bg","relatedIdentifierType":"URL"},{"relationType":"References","relatedIdentifier":"10.1016/j.cortex.2025.01.012","relatedIdentifierType":"DOI"}],"relatedItems":[{"relationType":"IsIdenticalTo","relatedItemIdentifier":{"relatedItemIdentifier":"https://archive.org/details/osf-registrations-8gnar-v1","relatedItemIdentifierType":"URL"},"relatedItemType":"Text","creators":[],"publisher":"OSF","titles":[],"contributors":[]},{"relationType":"IsVersionOf","relatedItemIdentifier":{"relatedItemIdentifier":"https://osf.io/sq4bg","relatedItemIdentifierType":"URL"},"relatedItemType":"Text","creators":[],"publisher":"OSF","publicationYear":"2023","titles":[{"title":"Gist vs detail memory and hippocampal volumes in ageing"}],"contributors":[]},{"relationType":"References","relatedItemIdentifier":{"relatedItemIdentifier":"10.1016/j.cortex.2025.01.012","relatedItemIdentifierType":"DOI"},"relatedItemType":"Text","creators":[],"publisher":"OSF","titles":[],"contributors":[]}],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"No license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study we will reanalyze a subset of the Cofitage dataset collected at the GIGA-Cyclotron\nResearch Centre/In Vivo Imaging of the University of Liège. Data from this dataset have been analyzed before, which led to several publications. Yet the hypotheses which we will test, and the analyses we will perform are new. The main variables of interest are age, hippocampal subfields volumes extracted from structural MRI data, and logical memory recall from the Wechsler memory scale III. Specifically, we will use a novel rating procedure, adapted from previous studies, which aims at dissociating details versus gist-like memory recall. We will investigate whether details/gist-like recall varies depending on age, and whether this relation is mediated by hippocampal subfields volumes. We will also explore the association with the volumes of the anterior and posterior portions of hippocampal subfields."}],"geoLocations":[],"fundingReferences":[],"url":"https://osf.io/8gnar/","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":16,"downloadCount":0,"referenceCount":1,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2024-09-19T15:12:40Z","registered":"2024-09-19T15:12:41Z","published":null,"updated":"2025-05-01T01:37:49Z"},"relationships":{"client":{"data":{"id":"cos.osf","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=COFITAGE\u0026page%5Bsize%5D=20"}}