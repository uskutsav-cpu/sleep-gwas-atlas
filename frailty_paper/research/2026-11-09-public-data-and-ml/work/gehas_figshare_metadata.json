{"files": [{"id": 54461009, "name": "es4c13675_si_001.pdf", "size": 972690, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/54461009", "supplied_md5": "554beef04e2f23bea05208bd0b149d71", "computed_md5": "554beef04e2f23bea05208bd0b149d71", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 9452528, "full_name": "Meijie Jiang", "first_name": "Meijie", "last_name": "Jiang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 434390, "full_name": "Yuting Wang", "first_name": "Yuting", "last_name": "Wang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 16531251, "full_name": "Sifan Tian", "first_name": "Sifan", "last_name": "Tian", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2344411, "full_name": "Shuzhen Liu", "first_name": "Shuzhen", "last_name": "Liu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 12992715, "full_name": "Yaxin Luo", "first_name": "Yaxin", "last_name": "Luo", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10746202, "full_name": "Haocan Song", "first_name": "Haocan", "last_name": "Song", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 34092, "full_name": "Jian Qin", "first_name": "Jian", "last_name": "Qin", "is_active": false, "url_name": "Jian_Qin", "orcid_id": ""}, {"id": 7875080, "full_name": "Yuebin Lv", "first_name": "Yuebin", "last_name": "Lv", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 7370534, "full_name": "Andrea A. Baccarelli", "first_name": "Andrea A.", "last_name": "Baccarelli", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 44058, "full_name": "Zhiyong Zhang", "first_name": "Zhiyong", "last_name": "Zhang", "is_active": false, "url_name": "Zhiyong_Zhang", "orcid_id": ""}, {"id": 238136, "full_name": "Xiaoming Shi", "first_name": "Xiaoming", "last_name": "Shi", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 51798, "full_name": "Xu Gao", "first_name": "Xu", "last_name": "Gao", "is_active": false, "url_name": "Xu_Gao", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Air_Pollution_Control_Mitigates_Frailty_Progression_Evidence_from_Two_Cohorts_of_Older_Adults_and_DNA_Methylation_Insights/29040497", "download_disabled": false, "description": "Frailty is an underappreciated but modifiable clinical\nsyndrome,\nbut little about how air quality improvements could influence frailty\nprogression is known. Here, we utilized two Chinese cohorts with repeated\nfollow-up visits to address this knowledge gap and explored the underlying\nDNA methylation mechanisms. We first conducted a multistate modeling\nanalysis in the Chinese Longitudinal Healthy Longevity Study (CLHLS),\na nationwide cohort with 21,654 older adults who had participated\nin at least two survey waves. An interquartile range reduction in\nPM<sub>2.5</sub> exposure increased the likelihood of improvement\nfor frail/prefrail individuals by more than 50% while lowering their\nrisks of worsening frailty or mortality. A quasi-experimental study\nwithin a CLHLS subcohort of 1816 adults, leveraging the implementation\nof China\u2019s Clean Air Act, further validated these findings.\nAdditionally, in the Guangxi Eco-Environmental Health and Aging Study\ue5f8a\nregional prospective cohort based in Guilin, China\ue5f8we included\n235 older adults with follow-up data and identified three frailty-related\nCpG sites that were associated with PM<sub>2.5</sub> exposure. The\nCpG site cg25453797 mapped to the <i>PRKCE</i> gene was\nrobustly associated with the change in frailty. These findings demonstrate\nthat air quality improvement benefits older adults by alleviating\nthe frailty burden. DNA methylation may serve as a potential biomarker\nto capture the health benefits of environmental policy interventions.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 972690, "created_date": "2025-05-12T12:23:44Z", "modified_date": "2025-05-12T12:23:44Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["related cpg sites", "multistate modeling analysis", "modifiable clinical syndrome", "interquartile range reduction", "experimental study within", "clean air act", "environmental policy interventions", "aging study \ue5f8", "identified three frailty", "654 older adults", "5 </ sub", "older adults", "prkce </", "environmental health", "china \ue5f8", "1816 adults", "worsening frailty", "two cohorts", "prefrail individuals", "potential biomarker", "nationwide cohort", "knowledge gap", "health benefits", "guangxi eco", "frailty burden", "first conducted", "clhls subcohort", "clhls ),", "china \u2019"], "keywords": ["related cpg sites", "multistate modeling analysis", "modifiable clinical syndrome", "interquartile range reduction", "experimental study within", "clean air act", "environmental policy interventions", "aging study \ue5f8", "identified three frailty", "654 older adults", "5 </ sub", "older adults", "prkce </", "environmental health", "china \ue5f8", "1816 adults", "worsening frailty", "two cohorts", "prefrail individuals", "potential biomarker", "nationwide cohort", "knowledge gap", "health benefits", "guangxi eco", "frailty burden", "first conducted", "clhls subcohort", "clhls ),", "china \u2019"], "categories": [{"id": 7, "title": "Medicine", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 13, "title": "Genetics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 16, "title": "Physiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 272, "title": "Environmental Sciences not elsewhere classified", "parent_id": 33, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biolog