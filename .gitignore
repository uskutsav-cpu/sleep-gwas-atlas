# Generated output. NEVER committed.
#
# The rule that motivates this file: a figure that outlives the logs and
# tables that produced it is an orphan, and an orphan figure with plausible
# numbers on it is indistinguishable from a real result. Figures are
# regenerated from logs; if the logs are gone, the figure must be gone too.

results/figures/*.png
results/figures/*.pdf
results/logs/*
results/tables/*
results/checkpoints/*
results/mixer/*

# Synthetic smoke-test output. This directory exists so that fake LDSC logs
# and real ones can never sit in the same folder. Nothing in it is ever a
# result, and nothing in it is ever committed.
results/_smoketest/

# Summary statistics: large, redistribution-restricted, and reproducible
# from the download step. (Remove these three lines if you decide raw
# sumstats should be tracked — nothing else here depends on them.)
data/raw/*
data/harmonized/*
data/munged/*
data/munged_chromosome_split/*
data/harmonized_mixer_full/*
data/mixer/*
data/pleiofdr/*
data/fine_mapping/*
data/molecular_coloc/*
data/twas/*
data/_test_*/
work/pleiofdr/
work/pleiotropy/
work/pleiofdr_traits/
work/fine_mapping/
work/fine_mapping_runs/
work/molecular/
work/molecular_coloc_runs/
work/twas_model_index/
work/twas_phi_inventory/
work/twas_runs/
work/interpretation_imports/
work/interpretation_automatic/
work/causal_reference/
work/causal_traits/
work/causal_runs/
work/robustness_imports/
results/fine_mapping/*
results/molecular/*
results/twas/*
results/interpretation/*
results/robustness/*

# Keep the directory skeleton so the pipeline's mkdir assumptions hold.
!.gitkeep

# Tooling
ldsc/
ref/
__pycache__/
*.pyc
.venv/
.ldsc-env/
.r-env/
.molecular-env/
.mr-env/
.snakemake/
.cache/
.DS_Store
