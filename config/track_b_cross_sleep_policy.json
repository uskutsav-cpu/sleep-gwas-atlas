    "priority_and_rules": [
      "BLOCKED when any of the twelve query rows for the pair/layer is BLOCKED or FAILED.",
      "INCONCLUSIVE when the layer is not blocked but any query is NOT_APPLICABLE or otherwise lacks complete comparable coverage.",
      "NO_DETECTED_SUPPORT when all twelve query families completed and none has supported evidence; this is not a biological null.",
      "SNORING_SPECIFIC when the complete supported sleep-trait set for an entity is exactly {snoring}.",
      "INSOMNIA_SPECIFIC when the complete supported sleep-trait set for an entity is exactly {insomnia}.",
      "SLEEP_BREATHING_SHARED when the set is exactly {snoring,sleep_apnea}.",
      "SLEEP_DISRUPTION_SHARED when the set is confined to DISRUPTION, contains insomnia, and contains at least one additional DISRUPTION trait.",
      "MULTIPLE_SLEEP_DIMENSIONS when support spans at least two frozen dimensions.",
      "NONSPECIFIC for every other complete supported pattern, including a single non-snoring/non-insomnia trait or a within-duration/within-timing pattern."
    ],
    "global_rg_exclusion": "GLOBAL_RG_CONTEXT never receives a mechanism-level classification.",
    "claim_limit": "These labels summarize recurrence patterns among the frozen sleep traits; even GENE_MECHANISM_EVIDENCE remains hypothesis-level and does not prove a shared mechanism."
